# =============================================================================
# BrandActivation Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control.
# =============================================================================

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-key

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-another-long-random-jwt-key
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
# JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/brandactivation_dev
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/brandactivation_test

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
# Maximum wrong OTP attempts before the code is invalidated
OTP_MAX_ATTEMPTS=3

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=BrandActivation <your-email@gmail.com>

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=BrandActivation
FRONTEND_URL=http://localhost:3000
